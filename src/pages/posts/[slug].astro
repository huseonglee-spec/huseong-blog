---
import FocusBlogConcept from "../../components/FocusBlogConcept.astro";
import HomeActions from "../../components/HomeActions.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPublishedPosts,
  getPublishedPostTranslation,
} from "../../lib/content";
import {
  parsePostTranslationLocale,
  postTranslationHref,
  type PostTranslationLocale,
} from "../../lib/post-translation";
import { postHref } from "../../lib/posts";

const activeSlug = Astro.params.slug;
const session = Astro.locals.adminSession;
const posts = await getPublishedPosts(Boolean(session));
const sourcePost = posts.find((post) => post.id === activeSlug);

if (!sourcePost) {
  return Astro.redirect("/404/");
}

let activeTranslationLocale: PostTranslationLocale | undefined;
const requestedLanguage = Astro.url.searchParams.get("lang");
if (requestedLanguage) {
  try {
    activeTranslationLocale = parsePostTranslationLocale(requestedLanguage);
  } catch {
    return Astro.redirect(postHref(sourcePost.id));
  }
}

const translatedPost = activeTranslationLocale
  ? await getPublishedPostTranslation(
      sourcePost.id,
      activeTranslationLocale,
      Boolean(session),
    )
  : null;
if (activeTranslationLocale && !translatedPost) {
  return Astro.redirect(postHref(sourcePost.id));
}
const activePost = translatedPost ?? sourcePost;
const visiblePosts = posts.map((post) =>
  post.id === sourcePost.id ? activePost : post,
);

Astro.response.headers.set("Cache-Control", "no-store");
const description = activePost.data.subtitle ?? activePost.data.title;
---

<BaseLayout
  title={`${activePost.data.title} · huseong.com`}
  description={description}
  canonicalPath={activeTranslationLocale
    ? postTranslationHref(activePost.id, activeTranslationLocale)
    : postHref(activePost.id)}
  type="article"
  language={activeTranslationLocale ?? "ko"}
>
  {session && (
    <HomeActions
      authenticated
      csrfToken={session.csrfToken}
      focusMode
    />
  )}
  <FocusBlogConcept
    posts={visiblePosts}
    variation="focus-index"
    initialSlug={activePost.id}
    authenticated={Boolean(session)}
    editCsrfToken={activeTranslationLocale ? undefined : session?.csrfToken}
    translationCsrfToken={activeTranslationLocale ? undefined : session?.csrfToken}
    activeTranslationLocale={activeTranslationLocale}
  />
</BaseLayout>
