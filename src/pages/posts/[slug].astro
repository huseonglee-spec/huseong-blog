---
import FocusBlogConcept from "../../components/FocusBlogConcept.astro";
import HomeActions from "../../components/HomeActions.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getPublishedPosts,
  getPublishedPostTranslation,
  getPublishedPostTranslationLocales,
} from "../../lib/content";
import {
  parsePostTranslationLocale,
  postTranslationHref,
  type PostTranslationLocale,
} from "../../lib/post-translation";
import { postHref } from "../../lib/posts";
import { getPostStudyPanel } from "../../lib/server/post-study";
import {
  READER_LOCALE_COOKIE,
  selectReaderLocalesByPost,
} from "../../lib/reader-language";

const activeSlug = Astro.params.slug;
const session = Astro.locals.adminSession;
const includeRestricted = Boolean(session);
Astro.response.headers.set("Cache-Control", "private, no-store");
Astro.response.headers.set("Vary", "Accept-Language, Cookie");
const [posts, availableTranslationLocalesByPost] = await Promise.all([
  getPublishedPosts(includeRestricted),
  getPublishedPostTranslationLocales(includeRestricted),
]);
const sourcePost = posts.find((post) => post.id === activeSlug);

if (!sourcePost) {
  return Astro.redirect("/404/");
}

const savedReaderLocale = Astro.cookies.get(READER_LOCALE_COOKIE)?.value;
const acceptLanguage = Astro.request.headers.get("accept-language");
const readerLocaleByPost = selectReaderLocalesByPost(
  posts.map((post) => post.id),
  availableTranslationLocalesByPost,
  savedReaderLocale,
  acceptLanguage,
);

let activeTranslationLocale: PostTranslationLocale | undefined;
const requestedLanguage = Astro.url.searchParams.get("lang");
if (requestedLanguage) {
  try {
    activeTranslationLocale = parsePostTranslationLocale(requestedLanguage);
  } catch {
    return Astro.redirect(postHref(sourcePost.id));
  }
} else {
  const preferredLocale = readerLocaleByPost[sourcePost.id] ?? "ko";
  if (preferredLocale !== "ko") {
    return Astro.redirect(postTranslationHref(sourcePost.id, preferredLocale));
  }
}

const translatedPost = activeTranslationLocale
  ? await getPublishedPostTranslation(
      sourcePost.id,
      activeTranslationLocale,
      includeRestricted,
    )
  : null;
if (activeTranslationLocale && !translatedPost) {
  return Astro.redirect(postHref(sourcePost.id));
}
const activePost = translatedPost ?? sourcePost;
const studyPanel = session && activeTranslationLocale
  ? await getPostStudyPanel(sourcePost.id, activeTranslationLocale)
  : undefined;
const visiblePosts = posts.map((post) =>
  post.id === sourcePost.id ? activePost : post,
);

const description = activePost.data.subtitle ?? activePost.data.title;
---

<BaseLayout
  title={`${activePost.data.title} · huseong.com`}
  description={description}
  canonicalPath={activeTranslationLocale
    ? postTranslationHref(activePost.id, activeTranslationLocale)
    : postHref(activePost.id)}
  type="article"
  language={activeTranslationLocale ?? "ko"}
>
  {session && (
    <HomeActions
      authenticated
      csrfToken={session.csrfToken}
      focusMode
    />
  )}
  <FocusBlogConcept
    posts={visiblePosts}
    variation="focus-index"
    initialSlug={activePost.id}
    authenticated={Boolean(session)}
    editCsrfToken={activeTranslationLocale ? undefined : session?.csrfToken}
    translationCsrfToken={activeTranslationLocale ? undefined : session?.csrfToken}
    translationEditCsrfToken={activeTranslationLocale ? session?.csrfToken : undefined}
    activeTranslationLocale={activeTranslationLocale}
    studyPanel={studyPanel}
    studyCsrfToken={studyPanel ? session?.csrfToken : undefined}
    availableTranslationLocalesByPost={availableTranslationLocalesByPost}
    readerLocaleByPost={readerLocaleByPost}
  />
</BaseLayout>
