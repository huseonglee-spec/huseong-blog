---
import { postHref, type BlogPost } from "../lib/posts";

import { renderPostMarkdown } from "../lib/markdown";
import type { PostStudyPanelView } from "../lib/post-study";
import {
  postTranslationHref,
  type PostTranslationLocale,
} from "../lib/post-translation";
import {
  READER_LOCALES,
  readerLocaleHref,
  readerLocaleLabel,
  type ReaderLocale,
} from "../lib/reader-language";
import { visibilityLabel } from "../lib/visibility";
import EditPostForm from "./EditPostForm.astro";
import EditPostTranslationForm from "./EditPostTranslationForm.astro";
import NewPostComposer from "./NewPostComposer.astro";
import PostStudyCompanion from "./PostStudyCompanion.astro";
import PostTranslationForm from "./PostTranslationForm.astro";

export type FocusVariation = "focus" | "focus-column" | "focus-index" | "focus-margin" | "focus-night";

interface Props {
  posts: BlogPost[];
  variation: FocusVariation;
  initialSlug?: string;
  authenticated?: boolean;
  composerCsrfToken?: string;
  composerSubmissionId?: string;
  composerOpen?: boolean;
  editCsrfToken?: string;
  translationCsrfToken?: string;
  translationEditCsrfToken?: string;
  activeTranslationLocale?: PostTranslationLocale;
  studyPanel?: PostStudyPanelView;
  studyCsrfToken?: string;
  availableTranslationLocalesByPost?: Record<string, PostTranslationLocale[]>;
  readerLocaleByPost?: Record<string, ReaderLocale>;
}

const {
  posts,
  variation,
  initialSlug,
  authenticated = false,
  composerCsrfToken,
  composerSubmissionId,
  composerOpen = false,
  editCsrfToken,
  translationCsrfToken,
  translationEditCsrfToken,
  activeTranslationLocale,
  studyPanel,
  studyCsrfToken,
  availableTranslationLocalesByPost = {},
  readerLocaleByPost = {},
} = Astro.props;
const renderedPosts = await Promise.all(
  posts.map(async (post) => ({
    post,
    ...(await renderPostMarkdown(post.bodyMarkdown)),
    readingMinutes: Math.max(1, Math.ceil(post.bodyMarkdown.length / 500)),
  })),
);
const categories = [...new Set(posts.map((post) => post.data.category))];
const categoryDirectory = categories.map((category) => ({
  category,
  segments: category.split("/"),
  count: posts.filter((post) => post.data.category === category).length,
}));
const variationInfo = {
  focus: {
    number: "01",
    name: "고요한 양옆",
    description: "선택한 글만 가운데 두고 카테고리와 아카이브를 양옆으로 밀어낸 기준안",
  },
  "focus-column": {
    number: "02",
    name: "한 줄 독서실",
    description: "탐색 레일을 최대한 얇게 줄이고 한 줄의 독서 흐름을 길게 남긴 변주",
  },
  "focus-index": {
    number: "03",
    name: "인덱스 독서실",
    description: "카테고리와 글 차례를 한쪽에 모아 자료실처럼 찾고 읽는 변주",
  },
  "focus-margin": {
    number: "04",
    name: "여백 노트",
    description: "넓은 여백에 글의 분류와 읽기 정보를 남긴 주석형 변주",
  },
  "focus-night": {
    number: "05",
    name: "밤의 독서실",
    description: "같은 집중 구조를 어두운 종이와 낮은 대비로 옮긴 야간 변주",
  },
} as const;
const info = variationInfo[variation];
const isActualPreview = variation === "focus-index";
const requestedInitialIndex = initialSlug
  ? renderedPosts.findIndex(({ post }) => post.id === initialSlug)
  : 0;
const initialIndex = requestedInitialIndex >= 0 ? requestedInitialIndex : 0;
const initialCategory = posts[initialIndex]?.data.category ?? "";
const renderedReaderLocale = (post: BlogPost): ReaderLocale =>
  activeTranslationLocale && post.id === initialSlug
    ? activeTranslationLocale
    : "ko";
const isReaderLocaleAvailable = (post: BlogPost, locale: ReaderLocale): boolean =>
  locale === "ko" || (availableTranslationLocalesByPost[post.id] ?? []).includes(locale);
const READER_LOCALE_FLAGS: Record<ReaderLocale, string> = {
  ko: "🇰🇷",
  en: "🇺🇸",
  ja: "🇯🇵",
  "zh-CN": "🇨🇳",
};
const readerPostHref = (post: BlogPost) =>
  activeTranslationLocale && post.id === initialSlug
    ? postTranslationHref(post.id, activeTranslationLocale)
    : readerLocaleHref(post.id, readerLocaleByPost[post.id] ?? "ko");
---

<div
  class="focus-blog"
  data-focus-blog
  data-document-scroll
  data-variation={variation}
  data-post-count={renderedPosts.length}
  data-initial-post-index={initialIndex}
  data-study-panel={studyPanel ? "true" : undefined}
>
  {!isActualPreview ? (
    <header class="focus-topbar">
      <a class="focus-brand" href="/">
        <strong>huseong.com</strong>
        <span>이후성의 생각과 경험</span>
      </a>

      <nav class="top-categories" aria-label="글 카테고리">
        <button type="button" data-category-filter="" aria-pressed="true">
          모든 글 <sup>{posts.length}</sup>
        </button>
        {categoryDirectory.map(({ category, segments, count }) => (
          <button type="button" data-category-filter={category} aria-pressed="false" title={category}>
            {segments.at(-1)} <sup>{count}</sup>
          </button>
        ))}
      </nav>

      <div class="focus-utility">
        <span>{info.number} / FOCUS VARIATION</span>
        <a href="/design-lab/">다른 시안</a>
      </div>
    </header>
  ) : (
    <nav
      class:list={[
        "actual-mobile-controls",
        { "actual-mobile-controls--authenticated": authenticated },
      ]}
      aria-label="모바일 메뉴"
    >
      <button type="button" class="mobile-archive-toggle" data-mobile-archive-toggle aria-expanded="false">글 탐색</button>
      {!authenticated && <a href="/admin/login/">로그인</a>}
    </nav>
  )}

  {renderedPosts.length > 0 ? (
    <div class="focus-shell">
      <aside class="category-rail" aria-label="카테고리 디렉터리">
        {!isActualPreview && (
          <header>
            <span>SECTIONS</span>
            <strong>생각의 갈래</strong>
          </header>
        )}

        {isActualPreview ? (
          <nav class="category-accordion" data-category-accordion aria-label="카테고리별 글">
            <section class="accordion-group" data-accordion-category="__all__" data-all-posts>
              <button type="button" class="category-toggle" data-category-toggle aria-expanded="false">
                <strong>전체 글 보기</strong>
                <b>{posts.length}</b>
                <span class="accordion-chevron" aria-hidden="true"></span>
              </button>
              <div class="accordion-posts" data-accordion-posts hidden>
                {renderedPosts.map(({ post }, index) => (
                  <a
                    href={readerPostHref(post)}
                    data-post-index-button={index}
                    data-post-category={post.data.category}
                    aria-current={index === initialIndex ? "page" : undefined}
                  >
                    <i>{post.data.title}</i>
                  </a>
                ))}
              </div>
            </section>
            {categoryDirectory.map(({ category, segments, count }) => {
              const expanded = category === initialCategory;
              return (
                <section class="accordion-group" data-accordion-category={category}>
                  <button type="button" class="category-toggle" data-category-toggle aria-expanded={expanded ? "true" : "false"}>
                    <strong>{segments.at(-1)}</strong>
                    <b>{count}</b>
                    <span class="accordion-chevron" aria-hidden="true"></span>
                  </button>
                  <div class="accordion-posts" data-accordion-posts hidden={!expanded}>
                    {renderedPosts.map(({ post }, index) => post.data.category === category && (
                      <a
                        href={readerPostHref(post)}
                        data-post-index-button={index}
                        data-post-category={post.data.category}
                        aria-current={index === initialIndex ? "page" : undefined}
                      >
                        <i>{post.data.title}</i>
                      </a>
                    ))}
                  </div>
                </section>
              );
            })}
          </nav>
        ) : (
          <nav data-category-directory>
            <button type="button" data-category-filter="" aria-pressed="true">
              <span><i>ROOT</i><strong>모든 기록</strong></span>
              <b data-category-count>{posts.length}</b>
            </button>
            {categoryDirectory.map(({ category, segments, count }) => (
              <button type="button" data-category-filter={category} aria-pressed="false">
                <span>
                  <i>{segments.length > 1 ? segments.slice(0, -1).join(" / ") : "SECTION"}</i>
                  <strong>{segments.at(-1)}</strong>
                </span>
                <b data-category-count>{count}</b>
              </button>
            ))}
          </nav>
        )}

        {isActualPreview ? (
          !authenticated && <a class="sidebar-login" href="/admin/login/">로그인</a>
        ) : (
          <footer>
            <span>현재 분류</span>
            <strong data-active-category>모든 글</strong>
            <i><b data-active-category-count>{posts.length}</b>편</i>
          </footer>
        )}
      </aside>

      <main class="focus-reader" data-focus-reader>
        {!isActualPreview && (
          <header class="variation-intro">
            <span>{info.number}</span>
            <div>
              <strong>{info.name}</strong>
              <p>{info.description}</p>
            </div>
          </header>
        )}

        {composerCsrfToken && composerSubmissionId && (
          <NewPostComposer
            csrfToken={composerCsrfToken}
            submissionId={composerSubmissionId}
            open={composerOpen}
            categoryPaths={categories}
          />
        )}

        <section class="focus-viewport" aria-label="선택한 글">
          {renderedPosts.map(({ post, html, readingMinutes }, index) => (
            <article
              id={`post-${post.id}`}
              class="focus-post"
              data-focus-post
              data-post={post.id}
              data-post-href={readerPostHref(post)}
              data-rendered-language={renderedReaderLocale(post)}
              data-post-category={post.data.category}
              data-post-title={post.data.title}
              hidden={index !== initialIndex}
            >
              <div class="focus-post-display" data-post-display>
                <aside class="article-note" aria-label="글 정보">
                  <span>NOTE</span>
                  <dl>
                    <div><dt>분류</dt><dd>{post.data.category.replaceAll("/", " · ")}</dd></div>
                    <div><dt>위치</dt><dd>{String(index + 1).padStart(2, "0")} / {String(posts.length).padStart(2, "0")}</dd></div>
                    <div><dt>읽기</dt><dd>약 {readingMinutes}분</dd></div>
                  </dl>
                </aside>

                <div class="focus-copy">
                  <header class="post-heading">
                    <p class="post-meta">
                      <span>{post.data.category.replaceAll("/", " · ")}</span>
                      <span class="focus-post-actions">
                        {editCsrfToken && <i>{visibilityLabel(post.data.visibility)}</i>}
                        {activeTranslationLocale && post.id === initialSlug ? (
                          translationEditCsrfToken && (
                            <button
                              type="button"
                              data-edit-translation
                              aria-controls={`edit-post-translation-${post.id}-${activeTranslationLocale}`}
                              aria-expanded="false"
                            >언어판 수정</button>
                          )
                        ) : (
                          <>
                            {translationCsrfToken && (
                              <button
                                type="button"
                                data-add-translation
                                aria-controls={`translate-post-${post.id}`}
                                aria-expanded="false"
                              >언어판 추가</button>
                            )}
                            {editCsrfToken ? (
                              <button
                                type="button"
                                data-edit-post
                                aria-controls={`edit-post-${post.id}`}
                                aria-expanded="false"
                              >수정</button>
                            ) : !isActualPreview ? (
                              <span>{String(index + 1).padStart(2, "0")}</span>
                            ) : null}
                          </>
                        )}
                      </span>
                    </p>
                    <nav class="reader-language-list" aria-label="이 글의 언어판">
                      {READER_LOCALES.map((locale) => {
                        const available = isReaderLocaleAvailable(post, locale);
                        return available ? (
                          <a
                            class="reader-language-option"
                            href={locale === "ko"
                              ? postHref(post.id)
                              : postTranslationHref(post.id, locale)}
                            lang={locale}
                            hreflang={locale}
                            data-reader-language={locale}
                            aria-current={locale === renderedReaderLocale(post) ? "page" : undefined}
                          >
                            <span class="reader-language-flag" aria-hidden="true">
                              {READER_LOCALE_FLAGS[locale]}
                            </span>
                            <span>{readerLocaleLabel(locale)}</span>
                          </a>
                        ) : (
                          <span
                            class="reader-language-option"
                            lang={locale}
                            aria-disabled="true"
                            aria-label={`${readerLocaleLabel(locale)} — 아직 언어판 없음`}
                            title="아직 발행된 언어판이 없습니다"
                            data-reader-language-unavailable={locale}
                          >
                            <span class="reader-language-flag" aria-hidden="true">
                              {READER_LOCALE_FLAGS[locale]}
                            </span>
                            <span>{readerLocaleLabel(locale)}</span>
                          </span>
                        );
                      })}
                    </nav>
                    <h1>{post.data.title}</h1>
                    {post.data.subtitle && <p class="post-subtitle">{post.data.subtitle}</p>}
                  </header>
                  <div class="post-content post-body" set:html={html} />
                </div>
              </div>
              {translationCsrfToken && (
                <PostTranslationForm post={post} csrfToken={translationCsrfToken} />
              )}
              {editCsrfToken && <EditPostForm post={post} csrfToken={editCsrfToken} />}
              {translationEditCsrfToken && activeTranslationLocale && post.id === initialSlug && (
                <EditPostTranslationForm
                  post={post}
                  locale={activeTranslationLocale}
                  csrfToken={translationEditCsrfToken}
                />
              )}
            </article>
          ))}
        </section>
      </main>

      {studyPanel && studyCsrfToken && activeTranslationLocale && initialSlug && (
        <PostStudyCompanion
          slug={initialSlug}
          locale={activeTranslationLocale}
          csrfToken={studyCsrfToken}
          panel={studyPanel}
        />
      )}

      {!isActualPreview && (
        <aside class="post-rail" aria-label="글 차례">
          <header>
            <span>POST INDEX</span>
            <strong data-active-category>모든 글</strong>
            <i><b data-active-category-count>{posts.length}</b> POSTS</i>
          </header>

          <nav>
            {renderedPosts.map(({ post }, index) => (
              <a
                href={readerPostHref(post)}
                data-post-index-button={index}
                data-post-category={post.data.category}
                aria-current={index === initialIndex ? "page" : undefined}
              >
                <span>{String(index + 1).padStart(2, "0")}</span>
                <i>{post.data.title}</i>
              </a>
            ))}
          </nav>
        </aside>
      )}

      {!isActualPreview && (
        <footer class="reader-dock" aria-live="polite">
          <p><strong data-current-index>{String(initialIndex + 1).padStart(2, "0")}</strong><span>/</span><span data-filtered-total>{String(renderedPosts.length).padStart(2, "0")}</span></p>
          <div class="reader-progress" aria-hidden="true"><span data-progress style={`--progress:${(initialIndex + 1) / renderedPosts.length}`} /></div>
          <p data-current-title>{renderedPosts[initialIndex].post.data.title}</p>
          <div class="reader-buttons">
            <button type="button" aria-label="이전 글" data-previous-post disabled={initialIndex === 0}>←</button>
            <button type="button" aria-label="다음 글" data-next-post disabled={initialIndex === renderedPosts.length - 1}>→</button>
          </div>
        </footer>
      )}

    </div>
  ) : (
    <p class="empty-blog">아직 보여드릴 글이 없습니다.</p>
  )}
</div>

<script>
  import { READER_LOCALE_COOKIE } from "../lib/reader-language";

  const root = document.querySelector<HTMLElement>("[data-focus-blog]");
  const reader = root?.querySelector<HTMLElement>("[data-focus-reader]");

  if (root && reader) {
    const posts = Array.from(root.querySelectorAll<HTMLElement>("[data-focus-post]"));
    const indexLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>("[data-post-index-button]"));
    const readerLanguageLinks = Array.from(root.querySelectorAll<HTMLAnchorElement>("a[data-reader-language]"));
    const categoryButtons = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-category-filter]"));
    const categoryLabels = Array.from(root.querySelectorAll<HTMLElement>("[data-active-category]"));
    const categoryCounts = Array.from(root.querySelectorAll<HTMLElement>("[data-active-category-count]"));
    const accordionGroups = Array.from(root.querySelectorAll<HTMLElement>("[data-accordion-category]"));
    const categoryToggles = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-category-toggle]"));
    const mobileArchiveToggle = root.querySelector<HTMLButtonElement>("[data-mobile-archive-toggle]");
    const previousButton = root.querySelector<HTMLButtonElement>("[data-previous-post]");
    const nextButton = root.querySelector<HTMLButtonElement>("[data-next-post]");
    const currentIndex = root.querySelector<HTMLElement>("[data-current-index]");
    const filteredTotal = root.querySelector<HTMLElement>("[data-filtered-total]");
    const currentTitle = root.querySelector<HTMLElement>("[data-current-title]");
    const progress = root.querySelector<HTMLElement>("[data-progress]");
    const studyCompanion = document.querySelector<HTMLElement>("[data-post-study-companion]");
    const studyPanelSlug = studyCompanion?.dataset.postStudySlug;
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let visibleIndexes = posts.map((_, index) => index);
    let activePosition = Number(root.dataset.initialPostIndex ?? "0");
    let touchStartX = 0;
    let touchStartY = 0;

    const localeFromHref = (href: string): string =>
      new URL(href, window.location.origin).searchParams.get("lang") ?? "ko";

    const animationFrames = (direction: number): Keyframe[] => {
      const offset = direction >= 0 ? 22 : -22;
      switch (root.dataset.variation) {
        case "focus-column":
          return [{ opacity: 0, transform: `translateY(${offset}px)` }, { opacity: 1, transform: "translateY(0)" }];
        case "focus-index":
          return [{ opacity: 0, transform: `translateX(${offset}px)` }, { opacity: 1, transform: "translateX(0)" }];
        case "focus-margin":
          return [{ opacity: 0, clipPath: "inset(0 0 12% 0)" }, { opacity: 1, clipPath: "inset(0)" }];
        case "focus-night":
          return [{ opacity: 0 }, { opacity: 1 }];
        default:
          return [{ opacity: 0, transform: "scale(.992)" }, { opacity: 1, transform: "scale(1)" }];
      }
    };

    const showPosition = (nextPosition: number, animate = true, updateUrl = true) => {
      const clamped = Math.max(0, Math.min(nextPosition, visibleIndexes.length - 1));
      const postIndex = visibleIndexes[clamped] ?? 0;
      const nextPost = posts[postIndex];
      if (
        updateUrl &&
        studyPanelSlug &&
        nextPost?.dataset.post !== studyPanelSlug &&
        nextPost?.dataset.postHref
      ) {
        window.location.assign(nextPost.dataset.postHref);
        return;
      }
      if (
        updateUrl &&
        nextPost?.dataset.postHref &&
        localeFromHref(nextPost.dataset.postHref) !== (nextPost.dataset.renderedLanguage ?? "ko")
      ) {
        window.location.assign(nextPost.dataset.postHref);
        return;
      }
      const direction = clamped - activePosition;
      activePosition = clamped;

      posts.forEach((post, index) => { post.hidden = index !== postIndex; });
      indexLinks.forEach((link) => {
        if (Number(link.dataset.postIndexButton) === postIndex) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
      });

      const activePost = posts[postIndex];
      const activeGroup = accordionGroups.find((group) => group.dataset.accordionCategory === activePost?.dataset.postCategory);
      activeGroup?.querySelector<HTMLButtonElement>("[data-category-toggle]")?.setAttribute("aria-expanded", "true");
      const activePanel = activeGroup?.querySelector<HTMLElement>("[data-accordion-posts]");
      if (activePanel) activePanel.hidden = false;
      if (animate && !reducedMotion.matches) {
        activePost?.animate(animationFrames(direction), {
          duration: root.dataset.variation === "focus-night" ? 520 : 340,
          easing: "cubic-bezier(.2,.75,.2,1)",
        });
      }

      if (previousButton) previousButton.disabled = activePosition === 0;
      if (nextButton) nextButton.disabled = activePosition === visibleIndexes.length - 1;
      if (currentIndex) currentIndex.textContent = String(activePosition + 1).padStart(2, "0");
      if (filteredTotal) filteredTotal.textContent = String(visibleIndexes.length).padStart(2, "0");
      if (currentTitle) currentTitle.textContent = activePost?.dataset.postTitle ?? "";
      progress?.style.setProperty("--progress", String((activePosition + 1) / visibleIndexes.length));
      if (updateUrl && activePost?.dataset.postHref) {
        const target = new URL(activePost.dataset.postHref, window.location.origin);
        window.history.pushState({ post: activePost.dataset.post }, "", target);
        document.title = `${activePost.dataset.postTitle ?? "글"} · huseong.com`;
      }
      if (animate) window.scrollTo({ top: 0, behavior: reducedMotion.matches ? "auto" : "smooth" });
    };

    const setCategory = (category: string) => {
      visibleIndexes = posts
        .map((post, index) => ({ post, index }))
        .filter(({ post }) => !category || post.dataset.postCategory === category)
        .map(({ index }) => index);
      indexLinks.forEach((link) => {
        link.hidden = !visibleIndexes.includes(Number(link.dataset.postIndexButton));
      });
      categoryButtons.forEach((button) => {
        button.setAttribute("aria-pressed", String((button.dataset.categoryFilter ?? "") === category));
      });
      categoryLabels.forEach((label) => { label.textContent = category || "모든 글"; });
      categoryCounts.forEach((count) => { count.textContent = String(visibleIndexes.length); });
      activePosition = 0;
      showPosition(0);
    };

    previousButton?.addEventListener("click", () => showPosition(activePosition - 1));
    nextButton?.addEventListener("click", () => showPosition(activePosition + 1));
    categoryButtons.forEach((button) => {
      button.addEventListener("click", () => setCategory(button.dataset.categoryFilter ?? ""));
    });
    indexLinks.forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const postIndex = Number(link.dataset.postIndexButton);
        const targetPost = posts[postIndex];
        if (studyPanelSlug && targetPost?.dataset.post !== studyPanelSlug) return;
        if (localeFromHref(link.href) !== (targetPost?.dataset.renderedLanguage ?? "ko")) return;
        event.preventDefault();
        const position = visibleIndexes.indexOf(postIndex);
        if (position >= 0) {
          showPosition(position);
          root.dataset.archiveOpen = "false";
          mobileArchiveToggle?.setAttribute("aria-expanded", "false");
        }
      });
    });
    readerLanguageLinks.forEach((link) => {
      link.addEventListener("click", () => {
        const locale = link.dataset.readerLanguage;
        if (!locale) return;
        const secure = window.location.protocol === "https:" ? "; Secure" : "";
        document.cookie = `${READER_LOCALE_COOKIE}=${encodeURIComponent(locale)}; Path=/; Max-Age=31536000; SameSite=Lax${secure}`;
      });
    });
    categoryToggles.forEach((button) => {
      button.addEventListener("click", () => {
        const group = button.closest<HTMLElement>("[data-accordion-category]");
        const willExpand = button.getAttribute("aria-expanded") !== "true";
        button.setAttribute("aria-expanded", String(willExpand));
        const panel = group?.querySelector<HTMLElement>("[data-accordion-posts]");
        if (panel) panel.hidden = !willExpand;
      });
    });
    mobileArchiveToggle?.addEventListener("click", () => {
      const open = root.dataset.archiveOpen !== "true";
      root.dataset.archiveOpen = String(open);
      mobileArchiveToggle.setAttribute("aria-expanded", String(open));
    });

    window.addEventListener("popstate", () => {
      const matchedSlug = window.location.pathname.match(/^\/posts\/([a-z0-9]+(?:-[a-z0-9]+)*)\/$/)?.[1];
      const postIndex = matchedSlug
        ? posts.findIndex((post) => post.dataset.post === matchedSlug)
        : 0;
      if (postIndex < 0) return;
      if (studyPanelSlug && matchedSlug !== studyPanelSlug) {
        window.location.reload();
        return;
      }
      const currentLanguage = new URL(window.location.href).searchParams.get("lang") ?? "ko";
      const renderedLanguage = posts[postIndex]?.dataset.renderedLanguage ?? "ko";
      if (currentLanguage !== renderedLanguage) {
        window.location.reload();
        return;
      }
      visibleIndexes = posts.map((_, index) => index);
      indexLinks.forEach((link) => { link.hidden = false; });
      activePosition = postIndex;
      showPosition(activePosition, false, false);
      document.title = matchedSlug
        ? `${posts[postIndex]?.dataset.postTitle ?? "글"} · huseong.com`
        : "huseong.com";
    });

    document.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.closest("[data-post-study-companion], a, button, input, textarea, select, [contenteditable='true']")) return;
      if (event.key === "ArrowLeft") {
        event.preventDefault();
        showPosition(activePosition - 1);
      }
      if (event.key === "ArrowRight") {
        event.preventDefault();
        showPosition(activePosition + 1);
      }
      if (event.key === "Escape") {
        root.dataset.archiveOpen = "false";
        mobileArchiveToggle?.setAttribute("aria-expanded", "false");
      }
    });

    reader.addEventListener("touchstart", (event) => {
      touchStartX = event.changedTouches[0]?.clientX ?? 0;
      touchStartY = event.changedTouches[0]?.clientY ?? 0;
    }, { passive: true });
    reader.addEventListener("touchend", (event) => {
      const deltaX = touchStartX - (event.changedTouches[0]?.clientX ?? touchStartX);
      const deltaY = touchStartY - (event.changedTouches[0]?.clientY ?? touchStartY);
      if (Math.abs(deltaX) > 46 && Math.abs(deltaX) > Math.abs(deltaY)) {
        showPosition(activePosition + (deltaX > 0 ? 1 : -1));
      }
    }, { passive: true });

    showPosition(activePosition, false, false);
  }
</script>

