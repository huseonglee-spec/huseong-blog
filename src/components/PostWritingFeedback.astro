---
import type { PostWritingFeedbackLocale } from "../lib/post-writing-feedback";

interface Props {
  slug: string;
  locale: PostWritingFeedbackLocale;
  csrfToken: string;
}

const { slug, locale, csrfToken } = Astro.props;
---

<section
  class="writing-feedback"
  data-post-writing-feedback
  data-writing-feedback-slug={slug}
  data-writing-feedback-locale={locale}
  data-writing-feedback-csrf={csrfToken}
>
  <div class="writing-feedback-launch">
    <div>
      <strong>AI 피드백</strong>
      <span>저장하지 않은 현재 제목과 본문을 검토합니다.</span>
    </div>
    <button type="button" data-writing-feedback-request>피드백 요청</button>
  </div>

  <aside
    class="writing-feedback-panel"
    data-writing-feedback-panel
    aria-label="AI 글쓰기 피드백"
    aria-live="polite"
    hidden
  >
    <header>
      <div>
        <span>WRITING REVIEW</span>
        <strong>AI 피드백 <b data-writing-feedback-count>0</b></strong>
      </div>
      <button type="button" data-writing-feedback-close aria-label="피드백 닫기">×</button>
    </header>

    <p class="writing-feedback-status" data-writing-feedback-status>
      현재 초안은 요청 버튼을 누를 때만 검토합니다.
    </p>
    <p class="writing-feedback-stale" data-writing-feedback-stale hidden>
      이전 초안 기준
    </p>
    <div class="writing-feedback-items" data-writing-feedback-items></div>
    <p class="writing-feedback-empty" data-writing-feedback-empty hidden>
      다듬을 문제를 찾지 못했습니다.
    </p>

    <footer>
      <span>원문은 자동으로 변경하거나 저장하지 않습니다.</span>
      <button type="button" data-writing-feedback-rerun>다시 검토</button>
    </footer>
  </aside>
</section>

<script>
  interface FeedbackItem {
    itemKey: string;
    feedback: string;
    reason: string;
  }

  interface FeedbackView {
    generationId: string;
    status: "pending" | "processing" | "ready" | "failed" | "superseded";
    items: FeedbackItem[];
    error?: string;
  }

  const feedbackRoots = Array.from(
    document.querySelectorAll<HTMLElement>("[data-post-writing-feedback]"),
  );

  feedbackRoots.forEach((component) => {
    if (component.dataset.writingFeedbackReady === "true") return;
    component.dataset.writingFeedbackReady = "true";

    const form = component.closest<HTMLFormElement>("form");
    const root = component.closest<HTMLElement>("[data-focus-blog]");
    const panel = component.querySelector<HTMLElement>("[data-writing-feedback-panel]");
    const requestButton = component.querySelector<HTMLButtonElement>("[data-writing-feedback-request]");
    const rerunButton = component.querySelector<HTMLButtonElement>("[data-writing-feedback-rerun]");
    const closeButton = component.querySelector<HTMLButtonElement>("[data-writing-feedback-close]");
    const status = component.querySelector<HTMLElement>("[data-writing-feedback-status]");
    const stale = component.querySelector<HTMLElement>("[data-writing-feedback-stale]");
    const items = component.querySelector<HTMLElement>("[data-writing-feedback-items]");
    const empty = component.querySelector<HTMLElement>("[data-writing-feedback-empty]");
    const count = component.querySelector<HTMLElement>("[data-writing-feedback-count]");
    if (!form || !root || !panel || !requestButton || !status || !stale || !items || !empty || !count) return;

    const titleInput = form.querySelector<HTMLInputElement>("[name=title]");
    const bodyInput = form.querySelector<HTMLTextAreaElement>("[name=bodyMarkdown]");
    if (!titleInput || !bodyInput) return;

    const slug = component.dataset.writingFeedbackSlug ?? "";
    const locale = component.dataset.writingFeedbackLocale ?? "ko";
    const csrfToken = component.dataset.writingFeedbackCsrf ?? "";
    const endpoint = `/api/posts/${encodeURIComponent(slug)}/writing-feedback/`;
    let submittedSource: { title: string; bodyMarkdown: string } | undefined;
    let activeGenerationId: string | undefined;
    let pollTimer: number | undefined;
    let pollCount = 0;

    const source = () => ({
      title: titleInput.value,
      bodyMarkdown: bodyInput.value,
    });

    const setBusy = (busy: boolean) => {
      requestButton.disabled = busy;
      if (rerunButton) rerunButton.disabled = busy;
      requestButton.textContent = busy ? "검토 중…" : "피드백 요청";
    };

    const setPanelOpen = (open: boolean) => {
      if (open) {
        feedbackRoots.forEach((other) => {
          if (other !== component) {
            other.dispatchEvent(new CustomEvent("writing-feedback:close"));
          }
        });
        root.dataset.archiveOpen = "false";
        root.querySelector<HTMLButtonElement>("[data-mobile-archive-toggle]")
          ?.setAttribute("aria-expanded", "false");
      }
      panel.hidden = !open;
      root.dataset.writingFeedbackOpen = String(open);
    };

    const updateStale = () => {
      const current = source();
      const changed = Boolean(
        submittedSource &&
        (submittedSource.title !== current.title || submittedSource.bodyMarkdown !== current.bodyMarkdown),
      );
      stale.hidden = !changed;
    };

    const updateCount = () => {
      const visible = items.querySelectorAll("[data-writing-feedback-item]").length;
      count.textContent = String(visible);
      empty.hidden = visible > 0 || status.dataset.feedbackState !== "ready";
    };

    const itemCard = (item: FeedbackItem): HTMLElement => {
      const article = document.createElement("article");
      article.className = "writing-feedback-item";
      article.dataset.writingFeedbackItem = item.itemKey;

      const cardHeader = document.createElement("header");
      const label = document.createElement("strong");
      label.textContent = "피드백";
      const dismiss = document.createElement("button");
      dismiss.type = "button";
      dismiss.dataset.writingFeedbackDismiss = item.itemKey;
      dismiss.setAttribute("aria-label", "이 피드백 숨기기");
      dismiss.textContent = "×";
      cardHeader.append(label, dismiss);

      const feedback = document.createElement("p");
      feedback.textContent = item.feedback;
      const reasonLabel = document.createElement("b");
      reasonLabel.textContent = "이유";
      const reason = document.createElement("p");
      reason.className = "writing-feedback-reason";
      reason.textContent = item.reason;
      article.append(cardHeader, feedback, reasonLabel, reason);
      return article;
    };

    const renderView = (view: FeedbackView) => {
      activeGenerationId = view.generationId;
      status.dataset.feedbackState = view.status;
      if (view.status === "ready") {
        status.textContent = view.items.length > 0
          ? "현재 요청한 초안의 표현 문제입니다."
          : "현재 요청한 초안에서 다듬을 문제를 찾지 못했습니다.";
        items.replaceChildren(...view.items.map(itemCard));
        setBusy(false);
      } else if (view.status === "failed") {
        status.textContent = view.error ?? "피드백을 만들지 못했습니다.";
        items.replaceChildren();
        setBusy(false);
      } else if (view.status === "superseded") {
        status.textContent = "더 최근 초안의 검토 요청이 있습니다. 다시 검토해 주세요.";
        items.replaceChildren();
        setBusy(false);
      } else {
        status.textContent = view.status === "processing"
          ? "현재 초안을 검토하고 있습니다."
          : "OAuth worker가 검토할 차례를 기다리고 있습니다.";
      }
      updateCount();
      updateStale();
    };

    const responseJson = async (response: Response): Promise<Record<string, unknown>> => {
      const payload = await response.json().catch(() => ({})) as Record<string, unknown>;
      if (!response.ok) {
        throw new Error(typeof payload.error === "string" ? payload.error : "피드백 요청에 실패했습니다.");
      }
      return payload;
    };

    const poll = async (): Promise<void> => {
      if (!activeGenerationId) return;
      pollCount += 1;
      try {
        const response = await fetch(
          `${endpoint}?generationId=${encodeURIComponent(activeGenerationId)}`,
          {
            headers: { "x-csrf-token": csrfToken },
            credentials: "same-origin",
          },
        );
        const view = await responseJson(response) as unknown as FeedbackView;
        renderView(view);
        if (view.status === "pending" || view.status === "processing") {
          if (pollCount >= 160) throw new Error("피드백 생성 시간이 초과되었습니다.");
          pollTimer = window.setTimeout(poll, 1_500);
        }
      } catch (error) {
        status.dataset.feedbackState = "failed";
        status.textContent = error instanceof Error ? error.message : "피드백 상태를 확인하지 못했습니다.";
        setBusy(false);
      }
    };

    const requestFeedback = async (force = false) => {
      if (pollTimer !== undefined) window.clearTimeout(pollTimer);
      setPanelOpen(true);
      setBusy(true);
      items.replaceChildren();
      empty.hidden = true;
      count.textContent = "0";
      status.dataset.feedbackState = "pending";
      status.textContent = "현재 초안을 검토 대기열에 넣고 있습니다.";
      submittedSource = source();
      stale.hidden = true;
      pollCount = 0;

      const data = new FormData();
      data.set("csrfToken", csrfToken);
      data.set("locale", locale);
      data.set("title", submittedSource.title);
      data.set("bodyMarkdown", submittedSource.bodyMarkdown);
      data.set("force", String(force));

      try {
        const response = await fetch(endpoint, {
          method: "POST",
          body: data,
          credentials: "same-origin",
        });
        const queued = await responseJson(response);
        if (typeof queued.generationId !== "string") {
          throw new Error("피드백 작업 ID를 확인하지 못했습니다.");
        }
        activeGenerationId = queued.generationId;
        await poll();
      } catch (error) {
        status.dataset.feedbackState = "failed";
        status.textContent = error instanceof Error ? error.message : "피드백을 요청하지 못했습니다.";
        setBusy(false);
      }
    };

    requestButton.addEventListener("click", () => requestFeedback(false));
    rerunButton?.addEventListener("click", () => requestFeedback(true));
    closeButton?.addEventListener("click", () => setPanelOpen(false));
    component.addEventListener("writing-feedback:close", () => setPanelOpen(false));
    titleInput.addEventListener("input", updateStale);
    bodyInput.addEventListener("input", updateStale);
    form.querySelector<HTMLElement>("[data-cancel-edit], [data-cancel-translation-edit]")
      ?.addEventListener("click", () => setPanelOpen(false));

    items.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-writing-feedback-dismiss]");
      if (!button || !activeGenerationId) return;
      button.disabled = true;
      const data = new FormData();
      data.set("csrfToken", csrfToken);
      data.set("generationId", activeGenerationId);
      data.set("itemKey", button.dataset.writingFeedbackDismiss ?? "");
      try {
        const response = await fetch(endpoint, {
          method: "PATCH",
          body: data,
          credentials: "same-origin",
        });
        await responseJson(response);
        button.closest("[data-writing-feedback-item]")?.remove();
        updateCount();
      } catch (error) {
        button.disabled = false;
        status.textContent = error instanceof Error ? error.message : "피드백을 숨기지 못했습니다.";
      }
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !panel.hidden) setPanelOpen(false);
    });
    document.addEventListener("click", (event) => {
      const target = event.target as HTMLElement;
      if (target.closest("[data-edit-post], [data-edit-translation], [data-post-index-button]")) {
        setPanelOpen(false);
        return;
      }
      if (!target.closest("[data-mobile-archive-toggle]")) return;
      queueMicrotask(() => {
        if (root.dataset.archiveOpen === "true") setPanelOpen(false);
      });
    });
  });
</script>

<style>
  .writing-feedback { margin-top:1.2rem; }
  .writing-feedback-launch { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding:1rem 0; border-block:1px solid var(--line); }
  .writing-feedback-launch > div { display:grid; gap:.12rem; }
  .writing-feedback-launch strong { font-size:.8rem; }
  .writing-feedback-launch span { color:var(--muted,var(--ink-soft)); font-size:.62rem; line-height:1.5; }
  .writing-feedback button { font:inherit; cursor:pointer; }
  .writing-feedback-launch button,
  .writing-feedback-panel footer button { padding:.55rem .8rem; border:1px solid var(--ink); color:var(--paper); background:var(--ink); font-size:.68rem; }
  .writing-feedback button:disabled { cursor:wait; opacity:.56; }

  .writing-feedback-panel { position:fixed; z-index:60; top:var(--topbar); right:0; bottom:0; display:grid; grid-template-rows:auto auto auto minmax(0,1fr) auto; width:400px; min-height:0; padding:1.35rem; border-left:1px solid var(--line); color:var(--ink); background:color-mix(in srgb,var(--paper) 97%,white); box-shadow:-18px 0 52px rgba(42,37,31,.08); }
  .writing-feedback-panel[hidden] { display:none; }
  .writing-feedback-panel > header { display:flex; align-items:start; justify-content:space-between; gap:1rem; padding-bottom:1rem; border-bottom:1px solid var(--line); }
  .writing-feedback-panel > header > div { display:grid; gap:.2rem; }
  .writing-feedback-panel > header span { color:var(--muted,var(--ink-soft)); font-size:.52rem; letter-spacing:.14em; }
  .writing-feedback-panel > header strong { font-size:1rem; }
  .writing-feedback-panel > header strong b { display:inline-grid; place-items:center; min-width:1.45rem; height:1.45rem; margin-left:.35rem; border-radius:999px; color:var(--paper); background:var(--ink); font-size:.62rem; }
  .writing-feedback-panel > header button { padding:0; border:0; color:var(--muted,var(--ink-soft)); background:transparent; font-size:1.5rem; line-height:1; }
  .writing-feedback-status { margin:.9rem 0 0; color:var(--muted,var(--ink-soft)); font-size:.66rem; line-height:1.55; }
  .writing-feedback-stale { justify-self:start; margin:.6rem 0 0; padding:.24rem .45rem; border:1px solid color-mix(in srgb,#b46a44 40%,var(--line)); color:#8c4a2d; background:#fff3eb; font-size:.58rem; }
  .writing-feedback-items { min-height:0; margin-top:.8rem; overflow:auto; overscroll-behavior:contain; }
  .writing-feedback-item { padding:1rem 0; border-top:1px solid var(--line); }
  .writing-feedback-item > header { display:flex; align-items:center; justify-content:space-between; gap:1rem; }
  .writing-feedback-item > header strong,
  .writing-feedback-item > b { font-size:.58rem; letter-spacing:.08em; }
  .writing-feedback-item > header button { padding:0; border:0; color:var(--muted,var(--ink-soft)); background:transparent; font-size:1.1rem; }
  .writing-feedback-item p { margin:.45rem 0 .8rem; font-size:.76rem; line-height:1.7; }
  .writing-feedback-item .writing-feedback-reason { margin-bottom:0; color:var(--muted,var(--ink-soft)); font-size:.68rem; }
  .writing-feedback-empty { align-self:start; margin:1rem 0; color:var(--muted,var(--ink-soft)); font-size:.72rem; }
  .writing-feedback-panel > footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; padding-top:1rem; border-top:1px solid var(--line); }
  .writing-feedback-panel > footer span { color:var(--muted,var(--ink-soft)); font-size:.55rem; line-height:1.45; }
  .writing-feedback-panel > footer button { flex:none; }

  @media (min-width: 1200px) {
    :global(.focus-blog[data-focus-blog][data-writing-feedback-open="true"]) { --right-rail:400px; }
    :global(.focus-blog[data-focus-blog][data-writing-feedback-open="true"] .post-rail),
    :global(.focus-blog[data-focus-blog][data-writing-feedback-open="true"] .reader-dock) { display:none; }
    :global(.focus-blog[data-focus-blog][data-variation="focus-index"][data-writing-feedback-open="true"] .focus-reader[data-focus-reader]) {
      margin-right:400px;
      margin-left:var(--left-rail);
    }
    :global(.focus-blog[data-focus-blog][data-variation="focus-index"][data-writing-feedback-open="true"] .focus-post[data-focus-post]) {
      width:min(720px,100%);
    }
  }

  @media (max-width: 1199px) {
    :global(.focus-blog[data-focus-blog][data-writing-feedback-open="true"]) { --right-rail:0px; }
    .writing-feedback-panel { inset:auto 8px 8px; top:auto; bottom:8px; width:auto; max-height:min(74svh,760px); border:1px solid var(--line); border-radius:12px; box-shadow:0 -20px 60px rgba(42,37,31,.2); }
  }

  @media (max-width: 560px) {
    .writing-feedback-launch { align-items:flex-start; }
    .writing-feedback-launch span { max-width:26ch; }
    .writing-feedback-panel { padding:1rem; }
    .writing-feedback-panel > footer { align-items:flex-end; }
  }
</style>
