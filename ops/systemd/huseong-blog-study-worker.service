[Unit]
Description=Generate huseong.com language study items with Hermes OAuth
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/huseong/Workspace/huseong-blog
Environment=HOME=/home/huseong
Environment=PATH=/home/huseong/.nvm/versions/node/v25.1.0/bin:/home/huseong/.local/share/pnpm:/home/huseong/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HUSEONG_BLOG_STUDY_HERMES_PROFILE=linux-coder
Environment=HUSEONG_BLOG_STUDY_HERMES_MODEL=gpt-5.6-sol
ExecStart=/home/huseong/.nvm/versions/node/v25.1.0/bin/pnpm study:worker
TimeoutStartSec=15min
Nice=5
