[Unit]
Description=Generate huseong.com writing feedback with Hermes OAuth
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
TimeoutStartSec=15min
WorkingDirectory=/home/huseong/Workspace/.worktrees/huseong-blog-feedback-runtime
EnvironmentFile=/home/huseong/Workspace/huseong-blog/.env.local
Environment=PATH=/home/huseong/.nvm/versions/node/v25.1.0/bin:/home/huseong/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HUSEONG_BLOG_FEEDBACK_HERMES_PROVIDER=openai-codex
Environment=HUSEONG_BLOG_FEEDBACK_HERMES_PROFILE=linux-coder
Environment=HUSEONG_BLOG_FEEDBACK_HERMES_MODEL=gpt-5.6-sol
Environment=HUSEONG_BLOG_FEEDBACK_HERMES_PYTHON=/home/huseong/.hermes/hermes-agent/venv/bin/python3
Environment=HUSEONG_BLOG_FEEDBACK_HERMES_BIN=/home/huseong/.local/bin/hermes
Environment=HUSEONG_BLOG_FEEDBACK_MAX_JOBS=2
ExecStart=/home/huseong/.nvm/versions/node/v25.1.0/bin/node /home/huseong/.local/lib/pnpm-10.28.0/node_modules/pnpm/bin/pnpm.cjs feedback:worker
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/huseong/.hermes/profiles/linux-coder

[Install]
WantedBy=default.target
