[Unit]
Description=Generate huseong.com translation drafts with Hermes OAuth
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/huseong/Workspace/huseong-blog
Environment=HOME=/home/huseong
Environment=PATH=/home/huseong/.nvm/versions/node/v25.1.0/bin:/home/huseong/.local/share/pnpm:/home/huseong/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=HUSEONG_BLOG_TRANSLATION_HERMES_PROFILE=linux-coder
Environment=HUSEONG_BLOG_TRANSLATION_HERMES_PROVIDER=openai-codex
Environment=HUSEONG_BLOG_TRANSLATION_HERMES_MODEL=gpt-5.6-sol
Environment=HUSEONG_BLOG_TRANSLATION_HERMES_PYTHON=/home/huseong/.hermes/hermes-agent/venv/bin/python3
Environment=HUSEONG_BLOG_TRANSLATION_HERMES_BRIDGE=/home/huseong/Workspace/huseong-blog/scripts/hermes-oauth-stdin-bridge.py
ExecStart=/home/huseong/.nvm/versions/node/v25.1.0/bin/pnpm translation:worker
TimeoutStartSec=15min
Nice=5
